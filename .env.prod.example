# Шаблон production-окружения. Реальный .env.prod генерируется bootstrap.sh со свежими
# секретами и НЕ коммитится (см. .gitignore). Значения ниже — плейсхолдеры.

# PostgreSQL (основная БД ЕХД)
POSTGRES_DB=ehd
POSTGRES_USER=ehd
POSTGRES_PASSWORD=__CHANGE_ME__

# ClickHouse — демо-источник Reporter.
# Пароль reporter_ro ФИКСИРОВАН в infra/clickhouse/init/01-init.sql (внутренняя сеть, наружу не публикуется).
CLICKHOUSE_ADMIN_PASSWORD=__CHANGE_ME__
CLICKHOUSE_SRC_DB=ehd_src
CLICKHOUSE_RO_USER=reporter_ro
CLICKHOUSE_RO_PASSWORD=reporter_ro_local

# Первый администратор (создаётся при старте ehd-api)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=__CHANGE_ME__
ADMIN_EMAIL=admin@ehd.makeit.kz

# Auth Module: AUTH_ENC_KEY — 64 hex-символа (AES-256), AUTH_HMAC_KEY — ключ HMAC для ИИН
AUTH_ENC_KEY=__CHANGE_ME_64_HEX__
AUTH_HMAC_KEY=__CHANGE_ME__
SESSION_TTL=3h
TEMP_PASSWORD_TTL=72h
MAX_FAILED_ATTEMPTS=3

# ЭЦП: stub (sandbox) | ncalayer (RSA) | ncanode (RSA+ГОСТ РК, требует сайдкар ncanode)
EDS_MODE=stub
EDS_OCSP_ENABLED=true
