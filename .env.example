# Скопируй в .env: cp .env.example .env
# Значения ниже — только для локальной разработки. Production-секреты в репозиторий не попадают.

# Host-порты (меняй при конфликте с другими проектами)
# WEB_HOST_PORT=3000
# API_HOST_PORT=8080
# POSTGRES_HOST_PORT=5432
# CH_HTTP_HOST_PORT=8123
# CH_NATIVE_HOST_PORT=9000

# PostgreSQL (основная БД ЕХД)
POSTGRES_DB=ehd
POSTGRES_USER=ehd
POSTGRES_PASSWORD=ehd_local

# ClickHouse (тестовый read-only источник Reporter)
CLICKHOUSE_ADMIN_PASSWORD=ch_admin_local
CLICKHOUSE_SRC_DB=ehd_src
CLICKHOUSE_RO_USER=reporter_ro
CLICKHOUSE_RO_PASSWORD=reporter_ro_local

# Seed первого администратора (создаётся при старте ehd-api)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=Admin12345
ADMIN_EMAIL=admin@example.kz

# Auth Module. AUTH_ENC_KEY — hex AES-256 (64 hex-символа = 32 байта); AUTH_HMAC_KEY — ключ HMAC для ИИН.
# Значения ниже — только для локальной разработки. В production ключи задаются вне репозитория (secret manager).
AUTH_ENC_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
AUTH_HMAC_KEY=ehd-local-hmac-key
SESSION_TTL=3h
TEMP_PASSWORD_TTL=72h
MAX_FAILED_ATTEMPTS=3
COOKIE_SECURE=false

# ЭЦП (NCALayer). stub — sandbox (ручной ввод); ncalayer — реальная проверка CMS.
# Для ncalayer положите корни НУЦ РК в infra/eds-trust/ (см. README) и запустите NCALayer.
EDS_MODE=stub
EDS_OCSP_ENABLED=true
